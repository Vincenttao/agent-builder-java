  "transfer": {
    "type": "SCRIPT",
    "title": "理财账户资金不足：从本人模拟储蓄账户转入差额（本次只确认转账，不确认购买）",
    "resultScript": "wealth/transfer.py",
    "inputSchema": {
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string",
          "enum": [
            "demo"
          ]
        },
        "productId": {
          "type": "string",
          "enum": [
            "demo-wealth-a"
          ],
          "title": "模拟产品编号"
        },
        "amountFen": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "title": "需转入的差额（分，100分=1元）"
        },
        "purchaseAmountFen": {
          "type": "integer",
          "minimum": 100000,
          "maximum": 1000000,
          "title": "本次计划购买金额（分）"
        },
        "fromAccount": {
          "type": "string",
          "enum": [
            "funding"
          ]
        },
        "toAccount": {
          "type": "string",
          "enum": [
            "investment"
          ]
        }
      },
      "required": [
        "customerId",
        "productId",
        "amountFen",
        "purchaseAmountFen",
        "fromAccount",
        "toAccount"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "unknown"
          ]
        },
        "idempotencyKey": {
          "type": "string"
        },
        "orderId": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "idempotencyKey",
        "orderId"
      ],
      "additionalProperties": false
    },
    "summarySchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "unknown"
          ]
        },
        "idempotencyKey": {
          "type": "string"
        },
        "orderId": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "idempotencyKey",
        "orderId"
      ],
      "additionalProperties": false
    },
    "confirmationRequired": true,
    "terminal": false,
    "maxCalls": 5,
    "fixedArguments": {
      "customerId": "demo",
      "fromAccount": "funding",
      "toAccount": "investment"
    }
  },
