{
  "schemaVersion": 1,
  "name": "i豆员工福利",
  "description": "MOA 空模板装配出的员工福利应用示例；业务系统为独立 Mock。",
  "scope": {"own": ["员工i豆余额、礼品目录与兑换"], "delegated": ["采购申请交给 procurement"], "outside": ["人事政策等非福利问题交给 fallback"]},
