  "capabilities": [{"id": "procurement", "type": "agent", "connection": "procurement", "description": "采购申请"}, {"id": "fallback", "type": "agent", "connection": "fallback", "description": "福利范围外问题"}],
  "handoff": {"enabled": true, "target": "fallback", "unfinished": "ask", "resume": "prompt", "maxTasks": 2},
  "connections": {"idou": "http://127.0.0.1:8770", "procurement": "http://127.0.0.1:8770/a2a/procurement", "fallback": "http://127.0.0.1:8770/a2a/fallback"},
  "mapping": {"balancePath": "employee.wallet.availablePoints"}
