      "content": "package generated;\n\nimport com.openjiuwen.core.foundation.tool.Tool;\n\nimport java.util.LinkedHashMap;\nimport java.util.Map;\n\npublic final class AccountBalanceTool extends Tool {\n\n  private static final String INPUT_ERROR = \"TOOL_INPUT_CONTRACT_INVALID\";\n  private static final String RESPONSE_ERROR = \"TOOL_RESPONSE_CONTRACT_INVALID\";\n\n  private final Tool transport;\n\n  public AccountBalanceTool(Tool transport) {\n    super(transport.getCard());\n    this.transport = transport;\n  }\n\n  @Override\n  protected Object invokeInternal(Map<String, Object> inputs, Map<String, Object> kwargs) throws Exception {\n    validateInputs(inputs);\n\n    Object response = transport.invoke(inputs, kwargs);\n    return validateResponse(response);\n  }\n\n  private static void validateInputs(Map<String, Object> inputs) {\n    if (inputs == null || inputs.size() != 1 || !inputs.containsKey(\"accountId\")) {\n      throw new IllegalArgumentException(INPUT_ERROR);\n    }\n    Object accountId = inputs.get(\"accountId\");\n    if (!(accountId instanceof String value) || value.isBlank()) {\n      throw new IllegalArgumentException(INPUT_ERROR);\n    }\n  }\n\n  private static Map<String, Object> validateResponse(Object response) {\n    if (!(response instanceof Map<?, ?> map)) {\n      throw new IllegalStateException(RESPONSE_ERROR);\n    }\n    Object accountId = map.get(\"accountId\");\n    Object currency = map.get(\"currency\");\n    Object availableBalanceFen = map.get(\"availableBalanceFen\");\n    Object asOf = map.get(\"asOf\");\n    if (!(accountId instanceof String)\n        || !(currency instanceof String)\n        || !(availableBalanceFen instanceof Integer || availableBalanceFen instanceof Long)\n        || !(asOf instanceof String)) {\n      throw new IllegalStateException(RESPONSE_ERROR);\n    }\n\n    Map<String, Object> result = new LinkedHashMap<>();\n    result.put(\"accountId\", accountId);\n    result.put(\"currency\", currency);\n    result.put(\"availableBalanceFen\", availableBalanceFen);\n    result.put(\"asOf\", asOf);\n    return result;\n  }\n}\n"
