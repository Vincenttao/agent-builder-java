      "content": "{\n  \"baselineDigest\": \"793e2482795c1444591d60002459381638500b15e38d4beb6b3a21800f648be1\",\n  \"cases\": [\n    {\n      \"caseId\": \"TC-001\",\n      \"requirementIds\": [\n        \"BR-001\",\n        \"BR-002\",\n        \"BR-003\"\n      ],\n      \"assertions\": [\n        {\n          \"ruleId\": \"run-succeeded\",\n          \"expected\": true\n        },\n        {\n          \"ruleId\": \"equipment-report-schema\",\n          \"expected\": \"equipment-report@1\"\n        },\n        {\n          \"ruleId\": \"equipment-facts\",\n          \"expected\": {\n            \"source\": \"seed-equipment-001@1\",\n            \"status\": \"warning\",\n            \"equipmentId\": \"PUMP-001\",\n            \"temperatureCelsius\": 86\n          }\n        },\n        {\n          \"ruleId\": \"write-call-count\",\n          \"expected\": 0\n        }\n      ],\n      \"steps\": [\n        \"以业务输入“查询 PUMP-001 的状态、温度、来源并提供建议。”触发被测入口，并使用记录型 Tool transport 提供 seed-equipment-001@1 的正常设备数据。\",\n        \"核验运行成功，且返回结果符合 equipment-report@1 报告结构。\",\n        \"检查记录型 transport 的外部调用日志，确认只发生一次按 equipmentId=PUMP-001 的读取调用且写调用次数为 0；同时核验报告事实严格等于 equipmentId=PUMP-001、status=warning、temperatureCelsius=86、source=seed-equipment-001@1。\"\n      ]\n    },\n    {\n      \"caseId\": \"TC-002\",\n      \"requirementIds\": [\n        \"BR-001\",\n        \"BR-003\"\n      ],\n      \"assertions\": [\n        {\n          \"ruleId\": \"run-succeeded\",\n          \"expected\": true\n        },\n        {\n          \"ruleId\": \"asks-for-equipment-id\",\n          \"expected\": true\n        },\n        {\n          \"ruleId\": \"all-business-call-count\",\n          \"expected\": 0\n        }\n      ],\n      \"steps\": [\n        \"以业务输入“请查询设备状态。”触发被测入口，输入中不包含任何 equipmentId。\",\n        \"核验运行成功，且输出明确向用户追问缺失的设备编号。\",\n        \"检查记录型 transport 的外部调用日志，确认业务工具调用总数为 0，未发生任何读取或写入调用。\"\n      ]\n    },\n    {\n      \"caseId\": \"TC-003\",\n      \"requirementIds\": [\n        \"BR-002\",\n        \"BR-003\"\n      ],\n      \"assertions\": [\n        {\n          \"ruleId\": \"run-succeeded\",\n          \"expected\": true\n        },\n        {\n          \"ruleId\": \"tool-error-evidence\",\n          \"expected\": true\n        },\n        {\n          \"ruleId\": \"failure-output-no-facts\",\n          \"expected\": true\n        },\n        {\n          \"ruleId\": \"write-call-count\",\n          \"expected\": 0\n        }\n      ],\n      \"steps\": [\n        \"以业务输入“查询 PUMP-001 的状态。”触发被测入口，并让记录型 Tool transport 在读取 equipmentId=PUMP-001 时抛出超时异常。\",\n        \"核验运行成功且输出保留可追溯的工具错误证据。\",\n        \"检查失败输出，确认不含任何设备状态或数据来源事实；同时检查记录型 transport 的外部调用日志，确认写调用次数为 0，且超时未被吞掉或改写为编造数据。\"\n      ]\n    }\n  ]\n}\n"
