      "content": "{\n  \"baselineDigest\": \"31d9eccee9882bf0e97408f046523be66c6ab1451e53cf877bd0e8e6822c108c\",\n  \"cases\": [\n    {\n      \"caseId\": \"TC-001\",\n      \"requirementIds\": [\n        \"BR-001\",\n        \"BR-002\",\n        \"BR-003\"\n      ],\n      \"assertions\": [\n        {\n          \"ruleId\": \"run-succeeded\",\n          \"expected\": true\n        },\n        {\n          \"ruleId\": \"equipment-report-schema\",\n          \"expected\": \"equipment-report@1\"\n        },\n        {\n          \"ruleId\": \"equipment-facts\",\n          \"expected\": {\n            \"source\": \"seed-equipment-001@1\",\n            \"status\": \"warning\",\n            \"equipmentId\": \"PUMP-001\",\n            \"temperatureCelsius\": 86\n          }\n        },\n        {\n          \"ruleId\": \"write-call-count\",\n          \"expected\": 0\n        }\n      ],\n      \"steps\": [\n        \"Invoke the equipment-query skill in scenario equipment-normal with the user input '查询 PUMP-001 的状态、温度、来源并提供建议。' and capture the completed run result.\",\n        \"Verify the run record shows run-succeeded=true and the structured output declares schema equipment-report@1.\",\n        \"Verify external state from the transport recording: returned equipment facts equal Map {source=seed-equipment-001@1, status=warning, equipmentId=PUMP-001, temperatureCelsius=86} with value equality, and the write-call counter remains 0.\"\n      ]\n    },\n    {\n      \"caseId\": \"TC-002\",\n      \"requirementIds\": [\n        \"BR-001\",\n        \"BR-003\"\n      ],\n      \"assertions\": [\n        {\n          \"ruleId\": \"run-succeeded\",\n          \"expected\": true\n        },\n        {\n          \"ruleId\": \"asks-for-equipment-id\",\n          \"expected\": true\n        },\n        {\n          \"ruleId\": \"all-business-call-count\",\n          \"expected\": 0\n        }\n      ],\n      \"steps\": [\n        \"Invoke the equipment-query skill in scenario equipment-missing-id with the user input '请查询设备状态。' (no equipmentId) and capture the completed run result.\",\n        \"Inspect the assistant response to confirm asks-for-equipment-id is true: it requests the missing equipmentId rather than guessing an ID.\",\n        \"Verify external state from the transport recording that all-business-call-count is 0, i.e. no equipment query tool invocation occurred.\"\n      ]\n    },\n    {\n      \"caseId\": \"TC-003\",\n      \"requirementIds\": [\n        \"BR-002\",\n        \"BR-003\"\n      ],\n      \"assertions\": [\n        {\n          \"ruleId\": \"run-succeeded\",\n          \"expected\": true\n        },\n        {\n          \"ruleId\": \"tool-error-evidence\",\n          \"expected\": true\n        },\n        {\n          \"ruleId\": \"failure-output-no-facts\",\n          \"expected\": true\n        },\n        {\n          \"ruleId\": \"write-call-count\",\n          \"expected\": 0\n        }\n      ],\n      \"steps\": [\n        \"Invoke the equipment-query skill in scenario equipment-tool-failure with read-timeout and the user input '查询 PUMP-001 的状态。' and capture the completed run result.\",\n        \"Verify the run record shows run-succeeded=true and exposes tool-error-evidence for the timed-out read call.\",\n        \"Verify external state: the failure output contains no fabricated status, temperature or source facts (failure-output-no-facts=true), and the write-call counter remains 0.\"\n      ]\n    }\n  ]\n}\n"
