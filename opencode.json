{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-local/deepseek-v4-flash",
  "small_model": "deepseek-local/deepseek-v4-flash",
  "provider": {
    "deepseek-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek (project configuration)",
      "options": { "apiKey": "{env:DEEPSEEK_API_KEY}", "baseURL": "https://api.deepseek.com/v1" },
      "models": { "deepseek-v4-flash": { "name": "DeepSeek V4 Flash (requested alias)" } }
    }
  },
  "agent": {
    "build": { "model": "deepseek-local/deepseek-v4-flash" },
    "plan": { "model": "deepseek-local/deepseek-v4-flash" }
  }
}
